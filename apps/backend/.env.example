# ───────── Prakash Mobile API — environment ─────────
# Copy to .env for local dev. On Railway, set these as service variables.

# Postgres (needs the pgvector extension — use the pgvector/pgvector image).
# Railway injects this automatically if you reference the Postgres service.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Auth — generate long random strings in production (e.g. `openssl rand -hex 32`).
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="12h"
JWT_REFRESH_TTL="30d"

# Public base URL of THIS API (used to build absolute upload URLs).
# In production set to the Railway API domain, e.g. https://api.up.railway.app
PUBLIC_URL="http://localhost:4000"

# Allowed browser origins (comma-separated). Set to your Vercel URL in prod.
# Leave unset to reflect any origin (fine for local dev).
# CORS_ORIGINS="https://prakash-mobile.vercel.app"

PORT="4000"

# AI assistant (Groq, OpenAI-compatible). Optional — features degrade without it.
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL_REASONING="llama-3.3-70b-versatile"
GROQ_MODEL_FAST="llama-3.1-8b-instant"

# Meilisearch (OPTIONAL — unset = automatic fallback to Postgres search).
# MEILI_HOST="http://meilisearch:7700"
# MEILI_MASTER_KEY="change-me"

# Razorpay online payments (OPTIONAL — only if you enable online checkout).
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
