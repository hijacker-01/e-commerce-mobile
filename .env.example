# ---- Backend ----
NODE_ENV=development
PORT=4000

# Postgres (with pgvector). Matches docker-compose.yml (host port 5433)
DATABASE_URL="postgresql://ecom:ecom_pass@localhost:5433/ecommerce?schema=public"

# Redis (cache + BullMQ queues)
REDIS_URL="redis://localhost:6379"

# Meilisearch (faceted product search)
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="dev_master_key_change_me"

# Auth
JWT_ACCESS_SECRET="change_me_access"
JWT_REFRESH_SECRET="change_me_refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# AI engine (Groq — OpenAI-compatible API)
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL_REASONING="llama-3.3-70b-versatile"
GROQ_MODEL_FAST="llama-3.1-8b-instant"

# Payments (India)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Notifications
FCM_SERVER_KEY=""
MSG91_AUTH_KEY=""

# Storage (S3 / Cloudflare R2)
S3_ENDPOINT=""
S3_BUCKET="ecom-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Maps
GOOGLE_MAPS_API_KEY=""

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---- Mobile (Expo) ----
EXPO_PUBLIC_API_URL="http://localhost:4000"
