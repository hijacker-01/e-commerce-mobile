# ───────── Prakash Mobile — production compose env ─────────
# Copy to .env.prod on the server and fill in. Never commit the real file.
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Public site address for Caddy:
#   ":80"               -> HTTP only, browse http://<server-ip>
#   "1-2-3-4.sslip.io"  -> free HTTPS on your IP (replace dots with dashes)
#   "shop.example.com"  -> your domain (auto-HTTPS)
SITE_ADDRESS=:80

# Public URL used to build absolute upload-image links. Must match the site:
#   http://<server-ip>   or   https://1-2-3-4.sslip.io   or   https://shop.example.com
PUBLIC_URL=http://localhost

# Database password (used by both postgres and the API connection string).
POSTGRES_PASSWORD=change-me-strong

# Auth secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# AI assistant (optional; leave blank to disable).
GROQ_API_KEY=
